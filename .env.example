NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig, niemals im Browser sichtbar (Supabase Dashboard > Project Settings > API)
SUPABASE_SERVICE_ROLE_KEY=

# Geheimer Schlüssel, den der Raspberry Pi beim Senden mitschickt (selbst erzeugt, z.B. per "openssl rand -hex 32")
PI_API_SECRET=

# Push-Benachrichtigungen (per "npx web-push generate-vapid-keys" erzeugt)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Schützt die tägliche Alarm-Prüf-Route vor fremdem Zugriff (selbst erzeugt, z.B. per "openssl rand -hex 32")
CRON_SECRET=

# Signiert das Login-Session-Cookie (selbst erzeugt, z.B. per "openssl rand -hex 32").
# Muss zusätzlich in den Vercel-Projekt-Envs gesetzt werden. Ändern des Werts
# invalidiert alle bestehenden Sessions (unkritisch - einfach neu per PIN einloggen).
SESSION_SECRET=

# Opas Telefonnummer für den "Opa anrufen"-Button. Wird client-seitig genutzt
# (daher NEXT_PUBLIC_) und landet dadurch im JS-Bundle der Live-App - das ist
# unvermeidbar, da sie aktiv in der UI gebraucht wird. Der Sinn dieser Env-
# Variable ist, sie aus dem Quellcode/GitHub-Repo herauszuhalten.
NEXT_PUBLIC_OPA_PHONE_NUMBER=

# Ungefährer Standort von Opa für die Sonnenuntergangs-Berechnung (nur
# serverseitig verwendet, landet nicht im Client-Bundle).
OPA_LAT=
OPA_LNG=
